      "name": "TC-API-001 | Obtain Authentication Token",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.unset('token');",
              "pm.environment.unset('existingId');",
              "pm.environment.unset('bookingId');",
              "pm.environment.set('qaReportJSON', '[]');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const qaMeta = {\"testId\":\"TC-API-001\",\"auth\":\"No\",\"bodySummary\":\"Official username/password (password omitted from report)\",\"expected\":\"200\"};",
              "let qaPassed = true;",
              "function qaTest(name, assertion) {",
              "  pm.test(qaMeta.testId + ' | ' + name, function () {",
              "    try { assertion(); } catch (error) { qaPassed = false; throw error; }",
              "  });",
              "}",
              "",
              "qaTest('Status code is 200', () => pm.expect(pm.response.code).to.eql(200));",
              "let data = {};",
              "qaTest('Response is valid JSON', () => { data = pm.response.json(); pm.expect(data).to.be.an('object'); });",
              "qaTest('Authentication token exists', () => { pm.expect(data.token).to.be.a('string').and.not.empty; });",
              "if (data.token) pm.environment.set('token', data.token);",
              "",
              "const safeBody = qaMeta.bodySummary || 'None';",
              "let qaReport = [];",
              "try { qaReport = JSON.parse(pm.environment.get('qaReportJSON') || '[]'); } catch (e) { qaReport = []; }",
              "qaReport.push({",
              "  testId: qaMeta.testId,",
              "  requestName: pm.info.requestName,",
              "  method: pm.request.method,",
              "  endpoint: pm.variables.replaceIn(pm.request.url.toString()),",
              "  authentication: qaMeta.auth,",
              "  requestBodySummary: safeBody,",
              "  expectedStatus: qaMeta.expected,",
              "  actualStatus: pm.response.code,",
              "  result: qaPassed ? 'PASS' : 'FAIL'",
              "});",
              "pm.environment.set('qaReportJSON', JSON.stringify(qaReport));",
              "console.log('QA_RESULT ' + JSON.stringify(qaReport[qaReport.length - 1]));"
            ]
          }
        }
      ],
